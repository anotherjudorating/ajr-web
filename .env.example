# The Data API, read by the site's server only (never sent to the browser).
SUPABASE_URL=https://vrnpqahtpjrlmlrkzbja.supabase.co
SUPABASE_KEY=sb_publishable_...
# The backend's update job sends it to /api/revalidate when the data changed.
REVALIDATE_SECRET=
# Past weeks' tables as files in R2 (lib/tables.ts); unset: the database answers.
AJR_DATA_URL=https://data.anotherjudorating.com
# The data client's limits (lib/data-client.ts), all optional; the defaults:
# AJR_DB_LIMIT=6 AJR_DB_QUEUE=40 AJR_DB_QUEUE_WAIT_MS=4000 AJR_DB_DEADLINE_MS=10000
# AJR_DB_BREAKER_FAILURES=5 AJR_DB_BREAKER_WINDOW_MS=10000 AJR_DB_BREAKER_OPEN_MS=15000
